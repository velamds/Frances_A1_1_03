": "text"}], "id": 1, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"type": "post_question", "contents": {"content": "", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "id": 6}], "type": "SFL", "id": 3, "stimuli_ids": []}, {"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"strong\">Vous rappelez-vous le m\u00e9l de Jean ?</span>", "type": "text"}, {"content": "<span class=\"italic\">Consignes : <br/>\n<span class=\"bullet\">Maintenant c'est \u00e0 vous d'\u00e9crire un m\u00e9l informel \u00e0 un ami ou une amie.</span><br/>\n<span class=\"bullet\">Prenez le m\u00e9l de Jean ci-dessous comme mod\u00e8le.</span></span>", "type": "text"}, {"content": "<style>\ndiv.indent  {margin-left: 2em;}\n</style>\n<br/><div class=indent><span class=\"italic\">Salut Pierre,<br/> <br/>\nQuoi de neuf ? J'ai besoin de ton aide !<br/> <br/>\nTu sais la librairie \u00e0 c\u00f4t\u00e9 de Chez Nanette ? On y embauche !<br/><br/>\nJ'ai besoin d'un emploi \u00e0 temps partiel. Aller \u00e0 l'universit\u00e9 devient de plus en plus cher. Je suis en train de remplir un formulaire de demande d'emploi en ce moment.<br/>\nIl y a tant de questions ! L'entrevue d'embauche a lieu jeudi prochain.<br/>\nQue dois-je \u00e9crire ? As-tu des id\u00e9es ?<br/> <br/>\nTon copain,<br/>\nJean</span></div><br/>", "type": "text"}, {"content": "<span class=\"bullet italic\">Lorsque vous avez \u00e9crit toutes vos notes, appuyez sur le bouton <span class=\"strong\">Allez \u00e0 l'exercice \u00e9crit</span>.</span>", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Vous avez fini !", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedbac